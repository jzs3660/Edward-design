  "buildArtifacts": {
    "compiledBackgrounds": {
      "source": "Packaged 1920×1080 lossless WebP background variant",
      "stored": false,
      "strategy": "The PPTX exporter converts each referenced WebP to a lossless PNG buffer in memory and caches it for the export run.",
      "purpose": "Reliable PowerPoint rendering without committing duplicate PNG copies"
    },
    "readmePreviews": [
