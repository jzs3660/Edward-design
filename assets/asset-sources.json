      "divider",
      "cardLayout",
      "pointLayout",
      "metricLayout",
      "comparisonCard",
      "comparisonPair",
      "imageCardLayout",
      "backgroundLayer",
      "textureOverlay",
      "chineseTypography",
      "gradientSwatches"
    ]
  },
  "backgroundVariantNodes": {
    "published": false,
    "coveredVariants": [
      "lightElementsCover",
      "lightElementsInner",
      "lightAtmosphereInner",
      "darkElementsCover",
      "darkElementsInner",
      "darkAtmosphereInner"
    ]
  },
  "imageMaskNodes": {
    "published": false,
    "coveredRoles": [
      "teamComponent",
      "teamClip",
      "teamRadialMask",
