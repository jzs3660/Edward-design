      },
      {
        "path": "assets/previews/aident-ppt-system.webp",
        "source": "Generated from packaged tokens, component, font, icon, and background registries",
        "runtimeRequired": false
      },
      {
        "path": "assets/previews/aident-ppt-showcase.webp",
        "source": "Generated English example HTML preflight montage",
        "runtimeRequired": false
      },
      {
        "path": "assets/previews/aident-ppt-showcase.zh.webp",
        "source": "Generated Chinese example HTML preflight montage",
        "runtimeRequired": false
