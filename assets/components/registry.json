    "point": { "themes": ["light", "dark"], "columns": [2, 3, 4], "layoutCounts": [2, 3, 4, 6], "widths": { "2": 760, "3": 486.6667, "4": 335 }, "showLabel": "optional", "showIcon": "optional", "alignment": "left", "height": "hug-with-budget" },
    "step": { "themes": ["light", "dark"], "columns": [3, 4], "widths": { "3": 486.6667, "4": 335 }, "showLabel": "optional", "alignment": "left", "height": "hug-with-budget", "containsArrow": false, "numberColors": { "light": "#008089", "dark": "#1EEAEA" } },
    "metric": { "themes": ["light", "dark"], "columns": [2, 3, 4], "layoutCounts": [2, 3, 4, 6], "widths": { "2": 760, "3": 486.6667, "4": 335 }, "showLabel": "optional", "alignment": "left", "height": "hug-with-budget" },
    "callout": { "themes": ["light", "dark"], "tones": ["default", "accent"], "contentVariants": ["labeled", "body-only"], "bullet": { "required": true, "size": 12, "colors": { "light": "#008089", "dark": "#1EEAEA" } }, "lead": { "keys": ["metric", "label"], "optional": true }, "bodyRequired": true, "standalone": false, "stroke": false, "width": 1700, "heights": { "default": 70, "accent": 88 }, "height": "hug", "padding": [20, 20], "itemGap": 12, "accentPaintOpacity": 0.16, "blurPx": 20 },
    "card": { "themes": ["light", "dark"], "sizes": ["half", "third", "dense-half", "dense-third"], "layoutCounts": [2, 3, 4, 6], "media": ["image", "none"], "showLabel": "optional", "showIcon": "optional", "alignment": "left", "height": "fill-row" },
    "workflow": { "themes": ["light", "dark"], "steps": [3, 4], "width": 1700, "showHeaderLabel": "optional", "showStepLabels": "optional", "showArrows": "optional", "showDividers": "optional", "alignment": "left", "structure": ["workflow-label?", "arrow-row", "step-row"], "arrow": { "separateFromStep": true, "rowHeight": 16, "columnGap": 60, "renderedCount": "steps", "onePerStep": true, "finalArrowVisible": true }, "stepRowGap": 120, "labelToArrowGap": 12, "arrowToStepGap": 32 },
    "comparison": { "themes": ["light", "dark"], "tones": ["standard", "accent"], "showBody": true, "items": [3, 4] },
